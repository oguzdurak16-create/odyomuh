{
  "name": "odyomuh-vercel",
  "version": "2.8.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run site:audit && npm run content:check && next build",
    "start": "next start",
    "check": "npm run site:audit && npm run content:check && npm run build",
    "site:audit": "node scripts/check-site-integrity.mjs",
    "daily:source-quality": "node scripts/check-daily-source-quality.mjs",
    "daily:editorial-quality": "node scripts/check-daily-editorial-quality.mjs",
    "daily:quality": "npm run daily:source-quality && npm run daily:editorial-quality",
    "content:check": "node scripts/check-english-content.mjs && npm run daily:quality"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "type": "module"
}
